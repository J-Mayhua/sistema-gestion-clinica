{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "rewrites": [
        {
            "source": "/clinica/publico/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/publico/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/clinica/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/clinica/publico/index.php",
            "destination": "/api/index.php"
        },
        {
            "source": "/publico/index.php",
            "destination": "/api/index.php"
        },
        {
            "source": "/clinica/index.php",
            "destination": "/api/index.php"
        },
        {
            "source": "/",
            "destination": "/api/index.php"
        }
    ]
}
