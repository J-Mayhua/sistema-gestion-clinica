# =======================================================================
# ⚠️  AVISO IMPORTANTE — LEER ANTES DE USAR ESTE ARCHIVO
# =======================================================================
# Este proyecto NO carga variables de entorno .env en tiempo de ejecución.
# El sistema de configuración oficial es:
#
#   config/config.local.php   ← ESTE es el archivo que debes editar
#
# Ese archivo usa constantes PHP definidas con define():
#
#   define('DB_HOST',     'localhost');
#   define('DB_NAME',     'clinica');
#   define('DB_USER',     'root');
#   define('DB_PASSWORD', '');
#
# Este archivo .env.example se conserva únicamente como:
#   - Referencia histórica de las variables que existirían en producción
#   - Guía de qué valores necesitarías si en el futuro se migra a un
#     sistema de variables de entorno (vlucas/phpdotenv, etc.)
#
# ✅ Para configurar el proyecto ahora mismo:
#   1. Abrir  config/config.local.php
#   2. Editar los valores de DB_HOST, DB_NAME, DB_USER, DB_PASSWORD
#   3. NUNCA subir config/config.local.php a Git (ya está en .gitignore)
#
# ❌ Copiar este archivo a .env NO tendrá ningún efecto en la aplicación.
# =======================================================================

# .env.example - Template de Variables de Entorno (SOLO REFERENCIA)

# IMPORTANTE:
# 1. Copiar este archivo a .env en producción
# 2. Rellenar con valores reales
# 3. NUNCA committerear .env a Git
# 4. NUNCA compartir valores en chats/emails

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_NAME=clinica
DB_USER=root
DB_PASS=
DB_PORT=3306

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_NAME=HappyDent
APP_ENV=development
# Opciones: development, staging, production
# En desarrollo: muestra errores
# En producción: errores en logs

APP_DEBUG=true
# true = mostrar errores (SOLO desarrollo)
# false = ocultar errores (producción)

APP_URL=http://localhost:80
# URL base de la aplicación
# Desarrollo: http://localhost/clinica1
# Producción: https://clinica.com

# ============================================
# EMAIL CONFIGURATION
# ============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-specific-password
# Nota: Para Gmail, usar "App Password", no contraseña normal
MAIL_FROM=noreply@clinica.com
MAIL_FROM_NAME=HappyDent

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_EMAIL=admin@clinica.com
ADMIN_NAME=Administrador

# ============================================
# SECURITY CONFIGURATION
# ============================================
SESSION_TIMEOUT=1800
# Tiempo en segundos antes de que expire sesión (30 min)

CSRF_TOKEN_ENABLED=true
# Habilitar protección CSRF (recomendado)

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=debug
# Niveles: debug, info, notice, warning, error, critical, alert, emergency
# debug = más verboso, emergency = solo críticos

# ============================================
# PAYMENT INTEGRATION (Futuro)
# ============================================
# STRIPE_PUBLIC_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx

# ============================================
# SMS INTEGRATION (Futuro)
# ============================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# CACHE CONFIGURATION (Futuro)
# ============================================
# CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ============================================
# NOTES
# ============================================
# Para obtener Gmail App Password:
# 1. Habilitar 2FA en tu Google Account
# 2. Ir a https://myaccount.google.com/apppasswords
# 3. Crear "App Password" para Mail
# 4. Copiar contraseña de 16 caracteres aquí

# Para desarrollo local con XAMPP:
# - DB_HOST: localhost
# - DB_USER: root
# - DB_PASS: (vacío, XAMPP default)

# Para producción VPS:
# - DB_HOST: localhost (o IP remota si BD está en otro servidor)
# - DB_USER: clinica_app (usuario limitado, NO root)
# - DB_PASS: Contraseña fuerte (genera con openssl: openssl rand -base64 32)
# - APP_ENV: production
# - APP_DEBUG: false
